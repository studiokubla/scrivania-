// Dynasty League — modello dati
//
// Convenzioni:
//  - tutti gli importi in milioni sono `Decimal(10,2)`: la lega lavora a step di 0,25 M
//    e i float non li rappresentano esattamente
//  - le entità che rappresentano un fatto avvenuto (movimenti, offerte, operazioni)
//    non si cancellano mai: si annullano con uno stato, così il registro dell'art. 22 resta intero
//  - ogni scrittura che il regolamento considera "operazione" scrive anche una riga in AuditEntry

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────── Lega, stagioni, utenti

model League {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Parametri del regolamento (art. 24: il commissioner può cambiarli senza voto
  /// solo se migliorativi allo stesso modo per tutti). Validato da RulesetSchema.
  ruleset   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasons Season[]
  teams   Team[]
  users   User[]
}

model Season {
  id        String       @id @default(cuid())
  leagueId  String
  /// Etichetta leggibile: "2025/26"
  label     String
  /// Anno di apertura: 2025 per la stagione 2025/26
  startYear Int
  phase     SeasonPhase  @default(PRESEASON)
  isCurrent Boolean      @default(false)
  /// Giornata di Serie A raggiunta dai dati importati (0 = nessun dato)
  matchday  Int          @default(0)

  league       League              @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  capitalTx    CapitalTransaction[]
  auctions     Auction[]
  marketWindows MarketWindow[]
  standings    StandingRow[]
  competitions Competition[]
  stadiums     Stadium[]
  academies    Academy[]
  scouts       Scout[]
  sponsorships Sponsorship[]
  draft        Draft?
  playerSeasons PlayerSeason[]
  optionUsages OptionUsage[]
  trades       Trade[]
  waivers      WaiverClaim[]
  auditEntries AuditEntry[]

  @@unique([leagueId, startYear])
  @@index([leagueId, isCurrent])
}

enum SeasonPhase {
  /// Asta e draft: la rosa si forma
  PRESEASON
  /// Campionato in corso
  REGULAR
  /// Opzioni, rinnovi, scadenze, bilancio
  POSTSEASON
  /// Stagione chiusa, sola lettura
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  leagueId     String
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(MANAGER)
  /// Un manager amministra una sola squadra; il commissioner nessuna (art. 1.2)
  teamId       String?  @unique
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  auditEntries AuditEntry[]

  @@index([leagueId])
}

enum UserRole {
  COMMISSIONER
  MANAGER
}

model Team {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  shortName String
  /// Colore di riconoscimento nell'interfaccia, formato #rrggbb
  color     String   @default("#4A4152")
  createdAt DateTime @default(now())

  league       League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  manager      User?
  contracts    Contract[]
  capitalTx    CapitalTransaction[]
  standings    StandingRow[]
  stadiums     Stadium[]
  academies    Academy[]
  scouts       Scout[]
  sponsorships Sponsorship[]
  youth        YouthPlayer[]
  optionUsages OptionUsage[]
  bids         AuctionBid[]
  auctionLots  AuctionLot[]
  offers       MarketOffer[]
  waiverClaims WaiverClaim[]
  tradesOut    Trade[]              @relation("TradeProposer")
  tradesIn     Trade[]              @relation("TradeReceiver")
  draftPicks   DraftPick[]
  auditEntries AuditEntry[]

  @@unique([leagueId, name])
  @@index([leagueId])
}

// ───────────────────────────────────────────────────────── Anagrafica giocatori

/// Anagrafica unica di un calciatore, indipendente dalla stagione.
/// `lfcId` è l'identificativo di Leghe Fantacalcio: è la chiave di riconciliazione
/// primaria perché è l'unica stabile tra un file voti e l'altro (art. 21.1).
model Player {
  id            String   @id @default(cuid())
  lfcId         Int?     @unique
  name          String
  /// Nome normalizzato per la riconciliazione fuzzy con Transfermarkt
  normalizedName String
  /// Ruolo classico Leghe Fantacalcio
  role          PlayerRole
  /// Ruoli Mantra, es. ["Dd","E"] — informativi, non usati dal motore regole
  mantraRoles   String[]  @default([])
  serieATeam    String?
  birthDate     DateTime?
  nationality   String?

  // Dati Transfermarkt (art. 21.2 — nessun effetto regolamentare)
  tmId              Int?
  /// Valore di mercato in euro
  tmMarketValue     BigInt?
  tmMarketValueAt   DateTime?
  /// Club di provenienza: alimenta il diritto di pareggio degli osservatori (art. 17.2)
  originClub        String?
  originLeague      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts     Contract[]
  seasons       PlayerSeason[]
  youthRecords  YouthPlayer[]
  auctionLots   AuctionLot[]
  offers        MarketOffer[]
  waiverClaims  WaiverClaim[]
  tradeItems    TradeItem[]

  @@index([normalizedName])
  @@index([serieATeam])
  @@index([tmId])
}

enum PlayerRole {
  P
  D
  C
  A
}

/// Dati di una stagione per un giocatore. Alimenta le condizioni del performance
/// buy-out (art. 12.4) e i requisiti primavera (art. 16.1), che devono essere
/// calcolabili senza intervento umano.
model PlayerSeason {
  id       String @id @default(cuid())
  playerId String
  seasonId String

  /// Quotazione iniziale Leghe Fantacalcio: determina la base d'asta (art. 8.4)
  quotationInitial Decimal? @db.Decimal(6, 2)
  quotationCurrent Decimal? @db.Decimal(6, 2)

  /// Giornate con voto ricevuto
  appearances       Int @default(0)
  /// Giornate consecutive senza voto in corso: soglia infortunio (art. 12.4)
  consecutiveNoVote Int @default(0)
  goals             Int @default(0)
  assists           Int @default(0)
  /// Somma dei voti puri, per la media
  voteSum           Decimal @default(0) @db.Decimal(8, 2)
  /// Somma dei fantavoti
  fantaVoteSum      Decimal @default(0) @db.Decimal(8, 2)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  votes  MatchdayVote[]

  @@unique([playerId, seasonId])
  @@index([seasonId])
}

/// Voto di una singola giornata, importato dai file ufficiali Leghe Fantacalcio.
/// Serve a ricostruire "5 giornate consecutive senza voto" senza fidarsi di un contatore.
model MatchdayVote {
  id             String  @id @default(cuid())
  playerSeasonId String
  matchday       Int
  /// null = non ha ricevuto voto (s.v. o non convocato)
  vote           Decimal? @db.Decimal(4, 2)
  fantaVote      Decimal? @db.Decimal(4, 2)
  goals          Int      @default(0)
  assists        Int      @default(0)
  yellowCard     Boolean  @default(false)
  redCard        Boolean  @default(false)

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)

  @@unique([playerSeasonId, matchday])
  @@index([matchday])
}

// ───────────────────────────────────────────────────────── Contratti

model Contract {
  id       String @id @default(cuid())
  teamId   String
  playerId String
  /// Stagione in cui il contratto è stato firmato
  seasonId String

  type   ContractType
  status ContractStatus @default(ACTIVE)

  /// Ingaggio del primo anno, in milioni
  baseSalary Decimal @db.Decimal(10, 2)
  /// Durata in stagioni al momento della firma
  years      Int
  /// Anno di apertura della prima stagione coperta (2025 = stagione 2025/26)
  startYear  Int
  /// Anno di apertura dell'ultima stagione coperta, estensioni comprese
  endYear    Int

  /// Ingaggio effettivo per stagione, già applicati escalator ed estensioni:
  /// [{ "year": 2025, "salary": "10.00", "source": "BASE" }, ...]
  /// Materializzato perché la matrice del cap si legge molto più spesso di quanto si scriva.
  salarySchedule Json

  /// Quante volte è stata esercitata la Team Option su questo contratto (art. 6.1)
  teamOptionsUsed Int @default(0)
  /// Contratto nato da un Franchise Tag (art. 6.2): non ripetibile l'anno dopo
  fromFranchiseTag Boolean @default(false)
  /// Contratto tampone: scade dopo 4 giornate (art. 4.4)
  expiresAtMatchday Int?

  /// Come si è chiuso il contratto, se chiuso
  endedReason ContractEndReason?
  endedAt     DateTime?
  /// Dead cap residuo a carico della squadra dopo un buy-out (art. 12.3)
  deadCapAmount Decimal? @db.Decimal(10, 2)
  /// Stagione a cui il dead cap resta imputato
  deadCapYear   Int?

  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  events     ContractEvent[]
  tradeItems TradeItem[]

  @@index([teamId, status])
  @@index([playerId, status])
  @@index([seasonId])
}

enum ContractType {
  /// 1 anno, nessun requisito, non occupa slot pluriennale (art. 4)
  ANNUALE
  /// 2-3 anni, +10% l'anno
  STANDARD
  /// Under 23 alla firma, 2-4 anni, max 6 M, invariato
  ROOKIE
  /// Over 30 alla firma, 2 anni, max 10 M, -20% l'anno
  VETERAN
  /// 4 giornate, max 1 M, massimo 3 a stagione
  TAMPONE
}

enum ContractStatus {
  ACTIVE
  /// Scaduto naturalmente: il giocatore è free agent
  EXPIRED
  /// Chiuso con buy-out (art. 12)
  BOUGHT_OUT
  /// Estinto perché il giocatore ha lasciato la Serie A (art. 13)
  TERMINATED
  /// Passato a un'altra squadra in un trade: resta a storico
  TRADED
}

enum ContractEndReason {
  EXPIRY
  BUYOUT
  PERFORMANCE_BUYOUT
  LEFT_SERIE_A
  LOAN_RELEASED
  TRADE
  YOUTH_FORCED_RELEASE
  COMMISSIONER_VOID
}

/// Storia di un contratto: ogni firma, estensione, tag, buy-out. Alimenta il registro
/// pubblico dell'art. 22 e permette di ricostruire come si è arrivati all'ingaggio attuale.
model ContractEvent {
  id         String            @id @default(cuid())
  contractId String
  type       ContractEventType
  /// Stagione (anno di apertura) in cui l'evento produce effetto
  effectiveYear Int
  amountBefore  Decimal? @db.Decimal(10, 2)
  amountAfter   Decimal? @db.Decimal(10, 2)
  note          String?
  createdAt     DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

enum ContractEventType {
  SIGNED
  TEAM_OPTION
  FRANCHISE_TAG
  ESCALATOR
  BUYOUT
  PERFORMANCE_BUYOUT
  TRADED
  LOAN_HALVED
  TERMINATED
  EXPIRED
  PROMOTED_FROM_YOUTH
}

/// Contatori delle opzioni consumate, azzerati al 1° luglio (art. 6).
/// Una riga per squadra, stagione e tipo: il vincolo di unicità è il contatore.
model OptionUsage {
  id       String     @id @default(cuid())
  teamId   String
  seasonId String
  type     OptionType
  used     Int        @default(0)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId, type])
}

enum OptionType {
  TEAM_OPTION
  FRANCHISE_TAG
  PERFORMANCE_BUYOUT
  FREE_AGENCY_OFFER
  PRE_CONTRACT
  TAMPONE
}

// ───────────────────────────────────────────────────────── Asta di settembre

model Auction {
  id       String        @id @default(cuid())
  seasonId String
  status   AuctionStatus @default(SCHEDULED)
  /// Ordine di chiamata estratto: array di teamId, art. 8.1
  callOrder String[]     @default([])
  /// Indice del turno corrente dentro callOrder
  currentTurn Int        @default(0)
  /// Squadre che hanno dichiarato chiusa la propria asta (art. 8.2)
  passedTeams String[]   @default([])
  /// Secondi a disposizione per l'offerta segreta (art. 8.3)
  bidWindowSeconds Int   @default(20)
  startedAt  DateTime?
  finishedAt DateTime?

  season Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  lots   AuctionLot[]

  @@unique([seasonId])
}

enum AuctionStatus {
  SCHEDULED
  RUNNING
  PAUSED
  FINISHED
}

/// Una chiamata: un giocatore messo all'asta da una squadra.
model AuctionLot {
  id        String        @id @default(cuid())
  auctionId String
  playerId  String
  /// Squadra che ha chiamato il giocatore
  calledById String
  /// Base d'asta calcolata dalla quotazione LFC (art. 8.4)
  basePrice Decimal       @db.Decimal(10, 2)
  status    AuctionLotStatus @default(OPEN)
  /// Momento oltre il quale le offerte non si accettano più
  closesAt  DateTime?
  /// Numero progressivo della chiamata
  sequence  Int

  wonByTeamId    String?
  winningAmount  Decimal?      @db.Decimal(10, 2)
  /// Tipo di contratto scelto all'aggiudicazione (art. 4.1)
  contractType   ContractType?
  contractYears  Int?
  /// Turno di spareggio: 0 = offerta iniziale, 1+ = ripetizioni per parità (art. 8.5)
  tieBreakRound  Int           @default(0)

  createdAt DateTime @default(now())

  auction  Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  player   Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  calledBy Team         @relation(fields: [calledById], references: [id], onDelete: Cascade)
  bids     AuctionBid[]

  @@unique([auctionId, sequence])
  @@index([auctionId, status])
}

enum AuctionLotStatus {
  OPEN
  /// Offerte chiuse, in attesa di apertura
  SEALED
  /// Parità: si ripete l'offerta
  TIE_BREAK
  ASSIGNED
  VOIDED
}

/// Offerta segreta su una chiamata. Resta nascosta finché il lotto non si apre:
/// il campo `revealedAt` è la garanzia che nessuno l'abbia vista prima (art. 8.3).
model AuctionBid {
  id       String @id @default(cuid())
  lotId    String
  teamId   String
  amount   Decimal @db.Decimal(10, 2)
  round    Int     @default(0)
  /// Impronta dell'offerta al momento dell'invio: rende dimostrabile che non è stata
  /// modificata dopo l'apertura
  fingerprint String
  submittedAt DateTime @default(now())
  revealedAt  DateTime?

  lot  AuctionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  team Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([lotId, teamId, round])
  @@index([lotId])
}

// ───────────────────────────────────────────────────────── Mercato

model MarketWindow {
  id       String           @id @default(cuid())
  seasonId String
  kind     MarketWindowKind
  label    String
  opensAt  DateTime
  closesAt DateTime
  status   MarketWindowStatus @default(SCHEDULED)

  season Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  offers MarketOffer[]
  trades Trade[]

  @@index([seasonId, status])
}

enum MarketWindowKind {
  SETTEMBRE
  NOVEMBRE
  GENNAIO
  MARZO
}

enum MarketWindowStatus {
  SCHEDULED
  OPEN
  CLOSED
}

/// Offerta di free agency o pre-contract. Il modello è uno solo perché il meccanismo
/// è lo stesso — busta chiusa, finestra di rilancio, apertura simultanea — e cambia
/// solo chi può rispondere.
model MarketOffer {
  id       String @id @default(cuid())
  windowId String
  teamId   String
  playerId String
  kind     OfferKind

  salary       Decimal      @db.Decimal(10, 2)
  years        Int
  contractType ContractType

  status OfferStatus @default(SEALED)
  /// Apertura automatica: 24 ore per la free agency (art. 9.2), 48 per il pre-contract (art. 11.2)
  closesAt DateTime
  /// L'offerta che ha aperto la contesa; le successive la referenziano
  parentOfferId String?
  /// Squadra che detiene il diritto di pareggio, se l'offerta è un pre-contract
  incumbentTeamId String?
  /// Vero se l'incumbent ha pareggiato e trattenuto il giocatore (art. 11.2)
  matchedByIncumbent Boolean @default(false)

  fingerprint String
  submittedAt DateTime  @default(now())
  revealedAt  DateTime?
  resolvedAt  DateTime?

  window MarketWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  team   Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  parent MarketOffer? @relation("OfferChain", fields: [parentOfferId], references: [id], onDelete: SetNull)
  children MarketOffer[] @relation("OfferChain")

  @@index([windowId, status])
  @@index([playerId, status])
  @@index([closesAt, status])
}

enum OfferKind {
  FREE_AGENCY
  PRE_CONTRACT
}

enum OfferStatus {
  /// Inviata, non ancora visibile a nessuno
  SEALED
  /// Aperta e in attesa di rilanci
  REVEALED
  WON
  LOST
  /// Pareggiata dall'incumbent: il giocatore resta dov'è
  MATCHED
  WITHDRAWN
  REJECTED
}

/// Reclamo su un giocatore appena svincolato (art. 10). Priorità inversa alla classifica.
model WaiverClaim {
  id       String @id @default(cuid())
  seasonId String
  teamId   String
  playerId String
  /// Contratto residuo che il reclamante si assume, se c'è
  assumedSalary Decimal? @db.Decimal(10, 2)
  assumedYears  Int?
  /// Scadenza delle 48 ore
  closesAt DateTime
  status   WaiverStatus @default(PENDING)
  /// Posizione in classifica del reclamante al momento del reclamo: congela il tie-break
  standingPosition Int
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, teamId, playerId])
  @@index([closesAt, status])
}

enum WaiverStatus {
  PENDING
  AWARDED
  LOST
  EXPIRED
}

model Trade {
  id         String @id @default(cuid())
  seasonId   String
  windowId   String?
  proposerId String
  receiverId String

  status TradeStatus @default(PROPOSED)
  /// Esito della validazione a due lati al momento della proposta (art. 11.1.2)
  validation Json?
  message    String?

  /// 48 ore per accettare (art. 11.1.3)
  expiresAt  DateTime
  respondedAt DateTime?
  /// 24 ore in cui il commissioner può annullare per collusione manifesta
  vetoableUntil DateTime?
  vetoReason    String?
  createdAt  DateTime @default(now())

  season   Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  window   MarketWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  proposer Team          @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  receiver Team          @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  items    TradeItem[]

  @@index([seasonId, status])
}

enum TradeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  /// Annullato dal commissioner per collusione manifesta
  VETOED
  EXECUTED
}

/// Un oggetto dello scambio. Si scambiano giocatori con il loro contratto,
/// scelte al draft e capitale — mai spazio salariale (art. 11.1.1).
model TradeItem {
  id      String        @id @default(cuid())
  tradeId String
  /// Squadra che cede questo oggetto
  fromTeamId String
  kind    TradeItemKind

  contractId String?
  playerId   String?
  draftPickId String?
  capitalAmount Decimal? @db.Decimal(10, 2)

  trade     Trade      @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  contract  Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  player    Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  draftPick DraftPick? @relation(fields: [draftPickId], references: [id], onDelete: SetNull)

  @@index([tradeId])
}

enum TradeItemKind {
  PLAYER
  DRAFT_PICK
  CAPITAL
}

// ───────────────────────────────────────────────────────── Capitale e società

/// Movimento del conto societario (art. 14). Non si cancella mai: si storna con
/// un movimento opposto, così il saldo è sempre la somma della colonna.
model CapitalTransaction {
  id       String @id @default(cuid())
  teamId   String
  seasonId String
  /// Positivo = entrata, negativo = uscita
  amount   Decimal @db.Decimal(10, 2)
  kind     CapitalKind
  description String
  /// Riferimento all'entità che ha generato il movimento (contratto, premio, investimento)
  refType  String?
  refId    String?
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([teamId, seasonId])
  @@index([seasonId, kind])
}

enum CapitalKind {
  INITIAL_ENDOWMENT
  COMPETITION_PRIZE
  STADIUM_INCOME
  STADIUM_BUILD
  STADIUM_UPGRADE
  STADIUM_MAINTENANCE
  ACADEMY_INVESTMENT
  ACADEMY_MAINTENANCE
  SCOUT_INVESTMENT
  SPONSOR_INCOME
  SPONSOR_PENALTY
  BUYOUT_PENALTY
  TRADE_TRANSFER
  COMMISSIONER_ADJUSTMENT
}

/// Stato dello stadio in una stagione (art. 15). Una riga per squadra e stagione:
/// così la storia degli impianti resta leggibile anno per anno.
model Stadium {
  id       String @id @default(cuid())
  teamId   String
  seasonId String
  level    Int    @default(0)
  /// Stagione in cui la costruzione è stata ordinata: gli incassi partono dalla 20ª (art. 15.1)
  builtInYear Int?
  operationalFromMatchday Int @default(20)
  /// Manutenzione già addebitata per questa stagione
  maintenancePaid Boolean @default(false)
  /// Retrocesso di livello per capitale insufficiente (art. 15.3)
  downgraded Boolean @default(false)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId])
}

/// Capienza del settore giovanile in una stagione (art. 16.2).
model Academy {
  id       String @id @default(cuid())
  teamId   String
  seasonId String
  capacity Int    @default(3)
  maintenancePaid Boolean @default(false)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([teamId, seasonId])
}

/// Giovane tesserato. Non percepisce ingaggio e non occupa spazio salariale
/// finché non viene promosso (art. 16.3-16.4).
model YouthPlayer {
  id       String @id @default(cuid())
  teamId   String
  playerId String
  /// Turno del draft in cui è stato scelto: determina l'ingaggio alla promozione
  draftRound Int
  draftPickNumber Int
  /// Stagione in cui è entrato nel settore giovanile
  joinedYear Int
  status   YouthStatus @default(IN_ACADEMY)
  promotedAt DateTime?
  releasedAt DateTime?

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([teamId, status])
}

enum YouthStatus {
  IN_ACADEMY
  PROMOTED
  /// Svincolato al compimento dei 21 anni per mancanza di spazio (art. 16.5)
  RELEASED
}

/// Osservatore inviato in un campionato o in un club (art. 17.2). `investedAt`
/// è ciò che risolve la gerarchia "chi ha investito prima".
model Scout {
  id       String @id @default(cuid())
  teamId   String
  seasonId String
  league   String
  /// null = osservatore sul campionato; valorizzato = osservatore su un club specifico
  club     String?
  cost     Decimal @db.Decimal(10, 2)
  /// Annulla l'osservatore generale sul campionato, se non se ne paga un secondo
  supersedesLeagueScout Boolean @default(false)
  investedAt DateTime @default(now())
  expiresAfterYear Int

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, league])
  @@index([seasonId, club])
}

/// Contratto di sponsorizzazione (art. 18).
model Sponsorship {
  id       String @id @default(cuid())
  teamId   String
  seasonId String
  name     String
  annualFee Decimal @db.Decimal(10, 2)
  years    Int
  startYear Int
  endYear   Int
  /// Obiettivo sportivo, es. { "type": "TOP_N", "n": 4, "competition": "APERTURA" }
  objective Json
  /// Penale se l'obiettivo non è raggiunto: 50% del compenso annuo
  penaltyRate Decimal @default(0.5) @db.Decimal(4, 2)
  status   SponsorshipStatus @default(ACTIVE)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
}

enum SponsorshipStatus {
  /// Proposta dal software, non ancora firmata
  OFFERED
  ACTIVE
  COMPLETED
  DECLINED
}

// ───────────────────────────────────────────────────────── Draft

model Draft {
  id       String @id @default(cuid())
  seasonId String @unique
  status   DraftStatus @default(SCHEDULED)
  /// Pesi della lotteria usati, congelati al momento dell'estrazione (art. 17.1)
  lotteryWeights Json?
  /// Seme dell'estrazione: rende l'ordine riproducibile e verificabile
  lotterySeed    String?
  drawnAt  DateTime?

  season Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  picks  DraftPick[]
}

enum DraftStatus {
  SCHEDULED
  LOTTERY_DONE
  RUNNING
  FINISHED
}

model DraftPick {
  id      String @id @default(cuid())
  draftId String
  /// Squadra che possiede la scelta adesso (può essere cambiata da un trade)
  teamId  String
  /// Squadra a cui la scelta apparteneva in origine
  originalTeamId String
  round   Int
  pickNumber Int
  /// Stagione a cui la scelta si riferisce: le scelte future sono scambiabili
  /// fino a due stagioni in avanti (art. 17.1)
  forYear Int
  usedPlayerId String?
  usedAt  DateTime?

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  items TradeItem[]

  @@unique([draftId, round, pickNumber])
  @@index([teamId])
}

// ───────────────────────────────────────────────────────── Competizioni

model Competition {
  id       String @id @default(cuid())
  seasonId String
  kind     CompetitionKind
  name     String
  status   CompetitionStatus @default(SCHEDULED)
  /// Tabella premi in milioni, per posizione o per turno raggiunto
  prizeTable Json
  /// Premi in euro (art. 20)
  cashPrizeTable Json?

  season   Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  fixtures Fixture[]
  standings StandingRow[]

  @@unique([seasonId, kind])
}

enum CompetitionKind {
  APERTURA
  CLAUSURA
  DYNASTY_CUP
  SUPER_CUP
  DYNASTY_YOUTH
}

enum CompetitionStatus {
  SCHEDULED
  RUNNING
  FINISHED
}

model Fixture {
  id            String @id @default(cuid())
  competitionId String
  /// Giornata della competizione
  round         Int
  /// Giornata di Serie A corrispondente: serve per gli incassi stadio
  serieAMatchday Int?
  homeTeamId    String
  awayTeamId    String
  /// Fantapunti, bonus stadio compreso
  homeScore     Decimal? @db.Decimal(6, 2)
  awayScore     Decimal? @db.Decimal(6, 2)
  /// Gol convertiti secondo la scala del fantacalcio
  homeGoals     Int?
  awayGoals     Int?
  /// Bonus stadio applicato alla squadra di casa (art. 15)
  homeStadiumBonus Decimal? @db.Decimal(4, 2)
  playedAt      DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, round])
}

model StandingRow {
  id            String @id @default(cuid())
  competitionId String
  seasonId      String
  teamId        String
  position      Int
  played        Int @default(0)
  won           Int @default(0)
  drawn         Int @default(0)
  lost          Int @default(0)
  points        Int @default(0)
  goalsFor      Int @default(0)
  goalsAgainst  Int @default(0)
  fantaPoints   Decimal @default(0) @db.Decimal(8, 2)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season      Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competitionId, teamId])
  @@index([seasonId, position])
}

// ───────────────────────────────────────────────────────── Registro (art. 22)

/// Riga del registro pubblico. Non si aggiorna e non si cancella: la correzione
/// di un errore è una riga nuova che annulla la precedente.
model AuditEntry {
  id       String @id @default(cuid())
  seasonId String
  /// Chi ha compiuto l'operazione; null per le operazioni automatiche del sistema
  userId   String?
  teamId   String?
  action   String
  /// Testo già formattato per il registro pubblico
  summary  String
  /// Dati completi dell'operazione, per ricostruirla
  payload  Json?
  /// Concatenazione con la riga precedente: rende evidente ogni manomissione
  previousHash String?
  hash     String
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([seasonId, createdAt])
  @@index([teamId, createdAt])
}

/// Traccia degli import dai file ufficiali (art. 21.3): chi, quando, quante righe,
/// quali giocatori non è stato possibile riconciliare.
model ImportRun {
  id       String @id @default(cuid())
  source   ImportSource
  kind     String
  matchday Int?
  fileName String
  rowsRead Int    @default(0)
  rowsApplied Int @default(0)
  /// Righe non riconciliate, da risolvere a mano
  unmatched Json?
  status   ImportStatus @default(RUNNING)
  error    String?
  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([source, createdAt])
}

enum ImportSource {
  LEGHE_FANTACALCIO
  TRANSFERMARKT
  MANUAL
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

/// Impostazioni interne dell'installazione.
///
/// Serve a una cosa sola ma importante: se `AUTH_SECRET` non è configurata come
/// variabile d'ambiente, la chiave che firma le sessioni viene generata alla
/// prima richiesta e conservata qui. Così mettere online la lega richiede una
/// variabile sola — la stringa del database — invece di tre, e la chiave resta
/// stabile fra un deploy e l'altro senza disconnettere nessuno.
///
/// La variabile d'ambiente, quando c'è, ha comunque la precedenza: è il modo
/// corretto in produzione, perché la chiave non tocca il database.
model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
