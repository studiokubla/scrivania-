# Sviluppo locale. In produzione questi valori arrivano dalle variabili d'ambiente
# dell'hosting (Vercel + Neon o Postgres gestito), mai da un file nel repository.
DATABASE_URL="postgresql://utente:password@host:5432/dynasty?schema=public"

# Firma dei cookie di sessione e delle impronte delle offerte a busta chiusa.
# Va cambiata in produzione: `openssl rand -base64 32`
AUTH_SECRET="genera-con-openssl-rand-base64-32"
